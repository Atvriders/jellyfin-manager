# Reference list of every setting. NOTE: docker compose does NOT read this file
# for the container. (Compose only reads a file named .env, and only to fill
# ${VARIABLES} inside docker-compose.yml, which uses none.) Put these values in
# docker-compose.yml's environment: block, or pass a copy of this file to
# `docker run --env-file .env`.

# Jellyfin server URL — used both to verify login credentials and to trigger scans (include port if not using reverse proxy)
JELLYFIN_URL=http://192.0.2.10:8096

# Jellyfin API key — Dashboard > Advanced > API Keys > + New Key (used for scan triggering)
JELLYFIN_API_KEY=your_api_key_here

# Flask session signing key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# This placeholder is ignored: the app falls back to a random key, so logins
# won't survive a restart until you set a real one.
SECRET_KEY=change_this_to_a_random_string

# Directory the scan history is written to (must match the mounted volume path)
DATA_DIR=/data

# Number of reverse proxies in front of the app that append to X-Forwarded-For:
# 1 for a single nginx/Traefik/Caddy or a Cloudflare Tunnel, 2 when one forwards
# to another (e.g. Cloudflare in front of Traefik). Unset or 0 = no proxy. Never
# set it higher than the real number (a client could then pick its own IP), and
# make sure nothing can reach the app's port without going through the proxies:
# anything that can reach it directly can fake its IP, in the history and to
# dodge the per-IP sign-in lockout (see the ports: note in docker-compose.yml)
# TRUST_PROXY=1

# Set to 1 to mark the login cookie Secure — only if every visit is over HTTPS
# (browsers never send a Secure cookie over plain http, so http logins break)
# SECURE_COOKIES=1

# Optional: show what qBittorrent is downloading and what's ready to scan in (see README)
# QBITTORRENT_INSTANCES=Box 1=http://192.0.2.20:8080, Box 2=http://192.0.2.21:8080
